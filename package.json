{
  "name": "voxhold-frontend",
  "private": true,
  "version": "2.7.0",
  "type": "module",
  "scripts": {
    "prepare:flags": "node scripts/prepare-flags.mjs",
    "dev": "npm run prepare:flags && vite",
    "build": "npm run prepare:flags && tsc -b && vite build && node scripts/check-bundle.mjs",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --exclude=e2e/**",
    "test:watch": "vitest --exclude=e2e/**",
    "test:e2e:stream": "playwright test e2e/stream-smoke.spec.ts",
    "test:e2e:performance": "playwright test --config playwright.performance.config.ts",
    "test:e2e:e2ee": "playwright test --config playwright.e2ee.config.ts",
    "test:e2e:features": "playwright test --config playwright.features.config.ts",
    "test:e2e:community": "playwright test --config playwright.community.config.ts",
    "test:e2e:ui": "playwright test --config playwright.ui.config.ts",
    "bench:optimization": "playwright test --config playwright.optimization.config.ts"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.24",
    "flag-icons": "^7.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "rollup-plugin-visualizer": "7.1.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
