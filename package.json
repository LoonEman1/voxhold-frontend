{
  "name": "voxhold-frontend",
  "private": true,
  "version": "1.13.0",
  "type": "module",
  "scripts": {
    "prepare:flags": "node scripts/prepare-flags.mjs",
    "dev": "npm run prepare:flags && vite",
    "build": "npm run prepare:flags && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --exclude=e2e/**",
    "test:watch": "vitest --exclude=e2e/**",
    "test:e2e:stream": "playwright test e2e/stream-smoke.spec.ts",
    "test:e2e:performance": "playwright test --config playwright.performance.config.ts",
    "test:e2e:ui": "playwright test --config playwright.ui.config.ts"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.22",
    "flag-icons": "^7.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.24.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
