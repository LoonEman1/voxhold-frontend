# В браузере оставьте пустым для same-origin /api через Vite/Nginx.
VITE_API_BASE_URL=
VITE_DEV_API_PROXY=http://localhost:8080
VITE_WEBRTC_ICE_SERVERS=
VITE_WEBRTC_ICE_USERNAME=
VITE_WEBRTC_ICE_CREDENTIAL=

# Docker runtime
BACKEND_UPSTREAM=host.docker.internal:8080
FRONTEND_PORT=3000

# Voice backend. Use 127.0.0.1 when Docker Desktop and the browser run on the
# same machine. For LAN clients use the host LAN IPv4; on a VPS use its public IP.
WEBRTC_PUBLIC_IP=127.0.0.1
WEBRTC_UDP_PORT=50000
WEBRTC_MAX_PARTICIPANTS=32
WEBRTC_MAX_AUDIO_BITRATE_KBPS=128
WEBRTC_STREAM_UDP_PORT=50001
WEBRTC_STREAM_MAX_VIEWERS=32
WEBRTC_STREAM_MAX_P2P_VIEWERS=8
WEBRTC_STREAM_MAX_VIDEO_BITRATE_KBPS=12000
WEBRTC_STREAM_MAX_AUDIO_BITRATE_KBPS=320
WEBRTC_ICE_SERVERS=
WEBRTC_ICE_USERNAME=
WEBRTC_ICE_CREDENTIAL=
